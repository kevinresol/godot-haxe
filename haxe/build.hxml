--macro include('gdcppia')
--macro include('gd')
--macro gdcppia.Patch.patch()
--class-path src
--class-path generated/src
--cpp bin
--define static_link
--define scriptable
--define HXCPP_CPP17
--define HXCPP_DEBUGGER
--define HXCPP_GC_CHECK_POINTER
--library hxcpp-debug-server
--library no-spoon

--debug
--dce no 

--each
--define HAXE_OUTPUT_PART=cppia_x86_64
--define HXCPP_M64

--next
--define HAXE_OUTPUT_PART=cppia_arm64
--define HXCPP_ARM64